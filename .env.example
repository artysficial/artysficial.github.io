# Copy to .env for local development. On the host, set these as environment variables instead.

# Public address of the site, used for canonical links, the sitemap and social previews
SITE_URL=http://localhost:3000

# Contact form email (Gmail: create an app password under Google Account > Security > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=artysficial@gmail.com
SMTP_PASS=
# Where messages are delivered (defaults to the email in content/site.json)
MAIL_TO=artysficial@gmail.com

# Private stats page at /admin; it stays disabled while ADMIN_PASSWORD is empty
ADMIN_USER=admin
ADMIN_PASSWORD=

# Where CV downloads and messages are stored: MongoDB if set (needed on hosts whose disk resets,
# such as Render's free plan), otherwise JSON Lines files in DATA_DIR (defaults to ./data)
# MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/?retryWrites=true&w=majority
# DATA_DIR=/var/data
