<!DOCTYPE html>
<html lang="en">

<head>
<%- include('partials/head', { title: `${article.title} | ${site.name}`, description: article.description }) %>

  <meta property="og:type" content="article">
  <meta property="og:title" content="<%= article.title %>">
  <meta property="og:description" content="<%= article.description %>">
  <meta property="og:url" content="<%= canonical %>">
  <meta property="og:image" content="<%= siteUrl + site.avatar %>">
  <meta property="article:published_time" content="<%= article.date %>">

  <link rel="stylesheet" href="<%= asset('/assets/css/article.css') %>">

  <script type="application/ld+json" nonce="<%= nonce %>">
  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: article.title,
    description: article.description,
    datePublished: article.date,
    author: { '@type': 'Person', name: site.name, url: siteUrl + '/' }
  }).replace(/</g, '\\u003c') %>
  </script>
</head>

<body>

  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="brand">
        <img src="<%= site.avatar %>" alt="" width="34" height="34">
        <span><%= site.name %></span>
      </a>

      <div class="topbar-actions">
        <a href="/#insights" class="back-link">&larr; All insights</a>

        <button class="theme-btn" type="button" data-theme-btn aria-label="Switch between light and dark mode">
          <ion-icon class="icon-moon" name="moon-outline"></ion-icon>
          <ion-icon class="icon-sun" name="sunny-outline"></ion-icon>
        </button>
      </div>
    </div>
  </header>

  <main class="post">

    <article>

      <p class="eyebrow">
        <span class="category"><%= article.category %></span>
        <span>&middot;</span>
        <time datetime="<%= article.date %>"><%= monthYear(article.date) %></time>
        <span>&middot;</span>
        <span><%= article.readTime %></span>
      </p>

      <h1><%= article.title %></h1>

      <p class="lead"><%= article.lead %></p>

      <div class="byline">
        <img src="<%= site.avatar %>" alt="" width="44" height="44">
        <div>
          <strong><%= site.name %></strong>
          <span><%= site.jobTitle %></span>
        </div>
      </div>

      <div class="prose">
<%- article.html %>
      </div>

    </article>

    <div class="share">
      <span>Found this useful?</span>
      <a href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent(canonical) %>" class="btn" target="_blank" rel="noopener" data-share-linkedin>Share on LinkedIn</a>
      <button class="btn" type="button" data-copy-link><span>Copy link</span></button>
    </div>

    <section class="author-card">
      <img src="<%= site.avatar %>" alt="Memoji of <%= site.name %>" width="72" height="72">
      <div>
        <h2>About the author</h2>
        <p><%= site.authorBio %></p>
        <div class="author-actions">
          <a href="mailto:<%= site.email %>?subject=<%= encodeURIComponent('Re: ' + article.title) %>" class="btn btn-primary">Email me</a>
          <a href="<%= site.linkedin %>" class="btn" target="_blank" rel="noopener">Connect on LinkedIn</a>
        </div>
      </div>
    </section>

    <nav class="more" aria-label="More insights">
      <h2>More insights</h2>
      <ul>
<% for (const other of others) { %>
        <li><a href="/articles/<%= other.slug %>"><%= other.title %></a></li>
<% } %>
      </ul>
    </nav>

  </main>

  <footer class="site-footer">
    <p>&copy; <span data-year><%= new Date().getFullYear() %></span> <%= site.name %> &middot; <a href="/">Portfolio</a></p>
  </footer>

  <script src="<%= asset('/assets/js/article.js') %>"></script>

<%- include('partials/ionicons') %>

</body>

</html>
